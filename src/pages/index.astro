---
import { cvData } from '../data/cvData.js';
import { Github, Linkedin, Code, Terminal, Mail, ChevronDown } from 'lucide-react';

// 定義元件內的簡單組件邏輯
const { name, title, coreSkills, education, skills, currentFocus, interests, socials, email } = cvData;
const currentYear = new Date().getFullYear();
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{name} | Portfolio</title>
		<style is:global>
			@import "tailwindcss";
			/* 模擬你原本的字體與選擇顏色 */
			:root {
				--orange-primary: #FF8C00;
			}
			body {
				background-color: #121212;
				font-family: "Cascadia Code", ui-sans-serif, system-ui, sans-serif;
			}
			::selection {
				background: var(--orange-primary);
				color: white;
			}
		</style>
	</head>
	<body class="text-white">
		
		<header class="min-h-screen flex flex-col justify-center items-center px-4 relative overflow-hidden">
			<div class="w-full max-w-5xl space-y-8 z-10">
				
				<div class="text-center space-y-2">
					<h1 class="text-4xl md:text-6xl font-bold tracking-tight">
						Hey, I'm <span class="text-[#FF8C00]">{name}</span>
					</h1>
					<p class="text-xl md:text-2xl text-gray-400 font-light">{title}</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-12 gap-4 w-full">
					<div class="md:col-span-8 bg-[#1E1E1E] p-8 rounded-3xl border border-gray-800 hover:border-[#FF8C00]/50 transition-colors group">
						<h3 class="text-2xl font-medium mb-6 flex items-center gap-2">
							<Terminal className="text-[#FF8C00]" /> Core Skills
						</h3>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							{coreSkills.map((skill) => (
								<div class="bg-[#2A2A2A] px-4 py-3 rounded-xl text-gray-200 group-hover:bg-[#333] transition-colors">
									{skill}
								</div>
							))}
						</div>
					</div>

					<div class="md:col-span-4 flex flex-col gap-4">
						<div class="bg-[#1E1E1E] p-6 rounded-3xl border border-gray-800 flex justify-around items-center h-full">
							<a href={socials.linkedin} target="_blank" class="text-white hover:text-[#FF8C00] transition-all"><Linkedin size={28} /></a>
							<a href={socials.github} target="_blank" class="text-white hover:text-[#FF8C00] transition-all"><Github size={28} /></a>
							<a href={socials.leetcode} target="_blank" class="text-white hover:text-[#FF8C00] transition-all"><Code size={28} /></a>
						</div>

						<a href={`mailto:${email}`} class="bg-[#FF8C00] text-black p-6 rounded-3xl font-bold text-xl flex justify-between items-center hover:bg-[#ff9f2e] transition-colors">
							<span>Let's Connect!</span>
							<Mail size={24} />
						</a>
					</div>
				</div>
			</div>
			<div class="absolute bottom-10 text-gray-500 animate-bounce">
				<ChevronDown size={32} />
			</div>
		</header>

		<main class="max-w-4xl mx-auto px-6 py-24 space-y-24">
			
			<section class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
				<div class="md:col-span-4">
					<h2 class="text-[#FF8C00] font-bold tracking-widest uppercase text-sm md:sticky md:top-10">Education</h2>
				</div>
				<div class="md:col-span-8">
					<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-2">
						<h3 class="text-xl font-medium text-white">{education.degree}</h3>
						<span class="text-[#FF8C00] font-mono mt-1 md:mt-0">{education.period}</span>
					</div>
					<p class="text-gray-400 text-lg">{education.school}</p>
					<p class="text-gray-500 mt-2 text-sm">{education.description}</p>
				</div>
			</section>

			<section class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
				<div class="md:col-span-4">
					<h2 class="text-[#FF8C00] font-bold tracking-widest uppercase text-sm md:sticky md:top-10">Skills & Tools</h2>
				</div>
				<div class="md:col-span-8 space-y-6">
					<div>
						<h4 class="text-lg font-medium text-white mb-2">Languages</h4>
						<p class="text-gray-400 leading-relaxed">
							{skills.languages.map((lang, i) => (
								<span class={i === 0 ? "text-[#FF8C00] font-medium" : "text-white mx-2"}>{lang}{i < skills.languages.length - 1 && ","}</span>
							))}
						</p>
					</div>
					<div class="h-px bg-gray-800 w-full" />
					<div>
						<h4 class="text-lg font-medium text-white mb-2">Core Competencies</h4>
						<ul class="list-disc list-inside text-gray-400 space-y-1 marker:text-[#FF8C00]">
							{skills.competencies.map(item => <li>{item}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
				<div class="md:col-span-4">
					<h2 class="text-[#FF8C00] font-bold tracking-widest uppercase text-sm md:sticky md:top-10">Interests</h2>
				</div>
				<div class="md:col-span-8">
					<div class="flex flex-wrap gap-3">
						{interests.map(item => (
							<span class="px-4 py-2 border border-gray-700 rounded-full text-gray-400 text-sm hover:border-[#FF8C00] hover:text-[#FF8C00] transition-colors cursor-default">
								{item}
							</span>
						))}
					</div>
				</div>
			</section>

			<footer class="pt-20 pb-10 text-center text-gray-600 text-sm">
				<p>© {currentYear} {name}.</p>
			</footer>
		</main>
	</body>
</html>