---
import "../styles/global.css";
import { i18nBundle, shared, locales } from "../data/i18n.js";

const { email, socials } = shared;
const initial = locales.en;
const { name, title, tagline, education, projects, skillTiles, ui } = initial;
const currentYear = new Date().getFullYear();
const i18nJson = JSON.stringify(i18nBundle);

const techIcons = {
  git: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/></svg>`,
  github: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>`,
  linux: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c-2 2-3 4.5-3 7.5 0 2 .5 3.5 1.5 4.5"/><path d="M12 3c2 2 3 4.5 3 7.5 0 2-.5 3.5-1.5 4.5"/><path d="M9 15c-1.5.5-3 2-3 4h12c0-2-1.5-3.5-3-4"/><circle cx="10" cy="10" r=".5" fill="currentColor"/><circle cx="14" cy="10" r=".5" fill="currentColor"/></svg>`,
  nodejs: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3.5 7v10L12 22l8.5-5V7L12 2z"/><path d="M12 22V12"/><path d="m3.5 7 8.5 5 8.5-5"/></svg>`,
  cpp: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  python: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8 2 8 4 8 6v2h8V6c0-2 0-4-4-4z"/><path d="M12 22c4 0 4-2 4-4v-2H8v2c0 2 0 4 4 4z"/><path d="M8 8H6c-2 0-2 1.5-2 3s0 3 2 3h2"/><path d="M16 16h2c2 0 2-1.5 2-3s0-3-2-3h-2"/></svg>`,
  htmlcss: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 8 2 12 4 16"/><polyline points="20 8 22 12 20 16"/><line x1="14" y1="4" x2="10" y2="20"/></svg>`,
  bash: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
};
---

<html lang="en" data-theme="dark" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      id="meta-description"
      name="description"
      content={`${name} — ${title}. ${tagline}`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title id="page-title">{name}</title>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          theme = theme === "light" || theme === "dark" ? theme : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
        try {
          var lang = localStorage.getItem("lang");
          lang = lang === "zh-Hant" || lang === "en" ? lang : "en";
          document.documentElement.setAttribute("data-lang", lang);
          document.documentElement.setAttribute("lang", lang === "zh-Hant" ? "zh-Hant" : "en");
        } catch (_) {
          document.documentElement.setAttribute("data-lang", "en");
          document.documentElement.setAttribute("lang", "en");
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="site-grain" aria-hidden="true"></div>
    <script
      is:inline
      id="i18n-bundle"
      type="application/json"
      set:html={i18nJson}
    ></script>

    <header class="relative min-h-screen flex flex-col">
      <nav
        class="flex items-center justify-between px-6 md:px-10 pt-8 max-w-6xl mx-auto w-full"
      >
        <a
          href="/"
          class="font-display text-sm tracking-[0.2em] uppercase text-[var(--ink)] no-underline"
        >
          JK
        </a>
        <div class="flex items-center gap-4 md:gap-5">
          <div class="nav-controls">
            <div class="lang-switch" id="lang-switch">
              <button
                type="button"
                class="lang-toggle"
                id="lang-toggle"
                aria-label={ui.langButton}
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="lang-menu"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M2 12h20"></path>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </button>
              <ul
                class="lang-menu"
                id="lang-menu"
                role="listbox"
                aria-label={ui.langButton}
              >
                <li role="none">
                  <button
                    type="button"
                    class="lang-option is-active"
                    role="option"
                    data-lang-value="en"
                    aria-selected="true"
                  >
                    English
                  </button>
                </li>
                <li role="none">
                  <button
                    type="button"
                    class="lang-option"
                    role="option"
                    data-lang-value="zh-Hant"
                    aria-selected="false"
                  >
                    繁體中文
                  </button>
                </li>
              </ul>
            </div>
            <button
              type="button"
              class="theme-toggle"
              id="theme-toggle"
              aria-label={ui.themeToLight}
            >
              <svg
                class="icon-sun"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
              </svg>
              <svg
                class="icon-moon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"></path>
              </svg>
            </button>
          </div>
          <a
            href={socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="GitHub"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path>
            </svg>
          </a>
          <a
            href={socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="LinkedIn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href={socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Instagram"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </a>
        </div>
      </nav>

      <div
        class="flex-1 flex flex-col justify-center px-6 md:px-10 max-w-6xl mx-auto w-full pb-24 pt-16"
      >
        <p
          class="animate-fade-up text-xs md:text-sm tracking-[0.25em] uppercase text-[var(--ink-muted)] mb-6"
          data-i18n="title"
        >
          {title}
        </p>

        <h1
          class="animate-fade-up-delay-1 font-display text-[clamp(2.75rem,10vw,7rem)] leading-[0.95] font-extrabold tracking-tight text-[var(--ink)] max-w-4xl"
          data-i18n="name"
        >
          {name}
        </h1>

        <div
          class="hero-rule mt-8 mb-8 h-px w-24 md:w-40 bg-[var(--line-strong)]"
          aria-hidden="true"
        >
        </div>

        <p
          class="animate-fade-up-delay-2 text-lg md:text-xl text-[var(--ink-muted)] max-w-xl leading-relaxed"
          data-i18n="tagline"
        >
          {tagline}
        </p>

        <div class="animate-fade-up-delay-3 mt-10 flex flex-wrap gap-3">
          <a href={`mailto:${email}`} class="btn-primary">
            <span data-i18n="ui.connect">{ui.connect}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>
          <a href="#projects" class="btn-ghost" data-i18n="ui.viewProjects">{ui.viewProjects}</a>
        </div>
      </div>

      <a
        href="#projects"
        class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 text-[var(--ink-faint)] no-underline"
        data-i18n-aria="ui.scrollProjects"
        aria-label={ui.scrollProjects}
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </header>

    <main class="max-w-6xl mx-auto px-6 md:px-10 pb-24 space-y-8 md:space-y-10">
      <section id="projects" class="scroll-mt-16">
        <div class="projects-heading">
          <h2
            class="font-display text-2xl md:text-3xl font-bold tracking-tight m-0"
            data-i18n="ui.projects"
          >
            {ui.projects}
          </h2>
          <p
            class="text-sm text-[var(--ink-faint)] hidden sm:block m-0 pb-1"
            data-i18n="ui.selectedWork"
          >
            {ui.selectedWork}
          </p>
        </div>

        <ul class="projects-grid" id="projects-list">
          {
            projects.map((project) => (
              <li>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-tile interactive-tile group"
                >
                  <p class="project-tile-year">{project.year}</p>
                  <div class="flex items-baseline gap-2">
                    <h3 class="project-tile-name group-hover:underline underline-offset-4 decoration-1">
                      {project.name}
                    </h3>
                    <svg
                      class="opacity-0 group-hover:opacity-100 transition-opacity shrink-0"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M7 17L17 7M7 7h10v10"></path>
                    </svg>
                  </div>
                  <p class="project-tile-desc">{project.description}</p>
                  <p class="project-tile-stack">{project.stack.join(" · ")}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section-panel interactive-tile">
        <h2 class="section-panel-title" data-i18n="ui.education">{ui.education}</h2>
        <div class="space-y-8" id="education-list">
          {
            education.map((item, index) => (
              <div class={index > 0 ? "pt-8 border-t border-[var(--line)]" : ""}>
                <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-1 mb-2">
                  <h3 class="text-xl font-medium m-0">{item.degree}</h3>
                  <span class="text-sm text-[var(--ink-faint)] tracking-wide">
                    {item.period}
                  </span>
                </div>
                <p class="text-lg text-[var(--ink-muted)] m-0">{item.school}</p>
                <p class="text-sm text-[var(--ink-faint)] mt-3 mb-0 leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="skills-grid" aria-label={ui.skills}>
        <div class="skill-tile interactive-tile">
          <h2 class="skill-tile-title" data-i18n="ui.techStack">{ui.techStack}</h2>
          <div class="skill-tile-chips" id="tech-stack-list">
            {
              skillTiles.techStack.map((item) => (
                <span class="skill-chip">
                  <span class="skill-chip-icon" set:html={techIcons[item.id] ?? ""} />
                  {item.label}
                </span>
              ))
            }
          </div>
        </div>
        <div class="skill-tile interactive-tile">
          <h2 class="skill-tile-title" data-i18n="ui.skills">{ui.skills}</h2>
          <div class="skill-tile-chips" id="skills-list">
            {
              skillTiles.skills.map((item) => (
                <span class="skill-chip">{item.label}</span>
              ))
            }
          </div>
        </div>
        <div class="skill-tile interactive-tile">
          <h2 class="skill-tile-title" data-i18n="ui.languages">{ui.languages}</h2>
          <div class="skill-tile-chips" id="languages-list">
            {
              skillTiles.languages.map((item) => (
                <span class="skill-chip">{item.label}</span>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer
      class="max-w-6xl mx-auto px-6 md:px-10 py-12 border-t border-[var(--line)] text-center"
    >
      <p class="m-0 text-sm text-[var(--ink-faint)]">
        © {currentYear} <span data-i18n="name">{name}</span>
      </p>
    </footer>

    <script>
      type LocaleCode = "en" | "zh-Hant";

      type SkillItem = { id: string; label: string };

      type LocaleData = {
        name: string;
        title: string;
        tagline: string;
        education: {
          degree: string;
          school: string;
          period: string;
          description: string;
        }[];
        skillTiles: {
          techStack: SkillItem[];
          skills: SkillItem[];
          languages: SkillItem[];
        };
        projects: {
          name: string;
          description: string;
          stack: string[];
          url: string;
          year: string;
        }[];
        ui: Record<string, string>;
      };

      type I18nBundle = {
        shared: { email: string; socials: Record<string, string> };
        locales: Record<LocaleCode, LocaleData>;
      };

      const THEME_KEY = "theme";
      const LANG_KEY = "lang";
      const WIPE_MS = 650;
      let wiping = false;

      const bundleEl = document.getElementById("i18n-bundle");
      const bundle = JSON.parse(bundleEl?.textContent || "{}") as I18nBundle;

      function getTheme() {
        return document.documentElement.getAttribute("data-theme") === "light"
          ? "light"
          : "dark";
      }

      function getLang(): LocaleCode {
        return document.documentElement.getAttribute("data-lang") === "zh-Hant"
          ? "zh-Hant"
          : "en";
      }

      function setTheme(theme: "light" | "dark") {
        document.documentElement.setAttribute("data-theme", theme);
        try {
          localStorage.setItem(THEME_KEY, theme);
        } catch (_) {
          /* ignore */
        }
        syncThemeToggle();
      }

      function syncThemeToggle() {
        const button = document.getElementById("theme-toggle");
        const locale = bundle.locales[getLang()];
        if (!button || !locale) return;
        button.setAttribute(
          "aria-label",
          getTheme() === "dark" ? locale.ui.themeToLight : locale.ui.themeToDark,
        );
      }

      function prefersReducedMotion() {
        return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      }

      function maxWipeRadius(x: number, y: number) {
        const w = window.innerWidth;
        const h = window.innerHeight;
        const corners = [
          [0, 0],
          [w, 0],
          [0, h],
          [w, h],
        ] as const;
        return Math.ceil(
          Math.max(...corners.map(([cx, cy]) => Math.hypot(cx - x, cy - y))),
        );
      }

      function runThemeWipe(button: HTMLElement, next: "light" | "dark") {
        if (wiping) return;
        wiping = true;

        const root = document.documentElement;
        const supportsVT =
          typeof (document as Document & { startViewTransition?: unknown })
            .startViewTransition === "function";

        if (prefersReducedMotion() || !supportsVT) {
          setTheme(next);
          wiping = false;
          return;
        }

        const rect = button.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        const r = maxWipeRadius(x, y);

        root.style.setProperty("--wipe-x", `${x}px`);
        root.style.setProperty("--wipe-y", `${y}px`);
        root.style.setProperty("--wipe-r", `${r}px`);
        root.classList.remove("theme-to-light", "theme-to-dark");
        root.classList.add(next === "light" ? "theme-to-light" : "theme-to-dark");
        document.body.style.transition = "none";

        let done = false;
        const cleanup = () => {
          if (done) return;
          done = true;
          root.classList.remove("theme-to-light", "theme-to-dark");
          document.body.style.transition = "";
          wiping = false;
        };

        const transition = (
          document as Document & {
            startViewTransition: (cb: () => void) => {
              finished: Promise<void>;
            };
          }
        ).startViewTransition(() => {
          setTheme(next);
        });

        transition.finished.then(cleanup).catch(cleanup);
        window.setTimeout(cleanup, WIPE_MS + 200);
      }

      function escapeHtml(value: string) {
        return value
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }

      function renderProjects(locale: LocaleData) {
        const list = document.getElementById("projects-list");
        if (!list) return;
        list.innerHTML = locale.projects
          .map(
            (project) => `
              <li>
                <a href="${escapeHtml(project.url)}" target="_blank" rel="noopener noreferrer" class="project-tile interactive-tile group">
                  <p class="project-tile-year">${escapeHtml(project.year)}</p>
                  <div class="flex items-baseline gap-2">
                    <h3 class="project-tile-name group-hover:underline underline-offset-4 decoration-1">${escapeHtml(project.name)}</h3>
                    <svg class="opacity-0 group-hover:opacity-100 transition-opacity shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M7 17L17 7M7 7h10v10"></path>
                    </svg>
                  </div>
                  <p class="project-tile-desc">${escapeHtml(project.description)}</p>
                  <p class="project-tile-stack">${escapeHtml(project.stack.join(" · "))}</p>
                </a>
              </li>`,
          )
          .join("");
      }

      function renderEducation(locale: LocaleData) {
        const list = document.getElementById("education-list");
        if (!list) return;
        list.innerHTML = locale.education
          .map(
            (item, index) => `
              <div class="${index > 0 ? "pt-8 border-t border-[var(--line)]" : ""}">
                <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-1 mb-2">
                  <h3 class="text-xl font-medium m-0">${escapeHtml(item.degree)}</h3>
                  <span class="text-sm text-[var(--ink-faint)] tracking-wide">${escapeHtml(item.period)}</span>
                </div>
                <p class="text-lg text-[var(--ink-muted)] m-0">${escapeHtml(item.school)}</p>
                <p class="text-sm text-[var(--ink-faint)] mt-3 mb-0 leading-relaxed">${escapeHtml(item.description)}</p>
              </div>`,
          )
          .join("");
      }

      const techIcons: Record<string, string> = {
        git: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/></svg>`,
        github: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>`,
        linux: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c-2 2-3 4.5-3 7.5 0 2 .5 3.5 1.5 4.5"/><path d="M12 3c2 2 3 4.5 3 7.5 0 2-.5 3.5-1.5 4.5"/><path d="M9 15c-1.5.5-3 2-3 4h12c0-2-1.5-3.5-3-4"/><circle cx="10" cy="10" r=".5" fill="currentColor"/><circle cx="14" cy="10" r=".5" fill="currentColor"/></svg>`,
        nodejs: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3.5 7v10L12 22l8.5-5V7L12 2z"/><path d="M12 22V12"/><path d="m3.5 7 8.5 5 8.5-5"/></svg>`,
        cpp: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
        python: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8 2 8 4 8 6v2h8V6c0-2 0-4-4-4z"/><path d="M12 22c4 0 4-2 4-4v-2H8v2c0 2 0 4 4 4z"/><path d="M8 8H6c-2 0-2 1.5-2 3s0 3 2 3h2"/><path d="M16 16h2c2 0 2-1.5 2-3s0-3-2-3h-2"/></svg>`,
        htmlcss: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 8 2 12 4 16"/><polyline points="20 8 22 12 20 16"/><line x1="14" y1="4" x2="10" y2="20"/></svg>`,
        bash: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
      };

      function renderSkillTiles(locale: LocaleData) {
        const techList = document.getElementById("tech-stack-list");
        if (techList) {
          techList.innerHTML = locale.skillTiles.techStack
            .map((item) => {
              const icon = techIcons[item.id] ?? "";
              return `<span class="skill-chip"><span class="skill-chip-icon">${icon}</span>${escapeHtml(item.label)}</span>`;
            })
            .join("");
        }

        const skillsList = document.getElementById("skills-list");
        if (skillsList) {
          skillsList.innerHTML = locale.skillTiles.skills
            .map((item) => `<span class="skill-chip">${escapeHtml(item.label)}</span>`)
            .join("");
        }

        const languagesList = document.getElementById("languages-list");
        if (languagesList) {
          languagesList.innerHTML = locale.skillTiles.languages
            .map((item) => `<span class="skill-chip">${escapeHtml(item.label)}</span>`)
            .join("");
        }
      }

      function resolveI18nPath(locale: LocaleData, path: string) {
        if (path === "name") return locale.name;
        if (path === "title") return locale.title;
        if (path === "tagline") return locale.tagline;
        if (path.startsWith("ui.")) return locale.ui[path.slice(3)] ?? "";
        return "";
      }

      function applyLang(code: LocaleCode) {
        const locale = bundle.locales[code];
        if (!locale) return;

        document.documentElement.setAttribute("data-lang", code);
        document.documentElement.setAttribute("lang", code === "zh-Hant" ? "zh-Hant" : "en");
        try {
          localStorage.setItem(LANG_KEY, code);
        } catch (_) {
          /* ignore */
        }

        document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (!key) return;
          el.textContent = resolveI18nPath(locale, key);
        });

        document.querySelectorAll<HTMLElement>("[data-i18n-aria]").forEach((el) => {
          const key = el.getAttribute("data-i18n-aria");
          if (!key) return;
          el.setAttribute("aria-label", resolveI18nPath(locale, key));
        });

        const titleEl = document.getElementById("page-title");
        if (titleEl) {
          titleEl.textContent = locale.name;
        }

        const meta = document.getElementById("meta-description");
        if (meta) {
          meta.setAttribute(
            "content",
            `${locale.name} — ${locale.title}. ${locale.tagline}`,
          );
        }

        const langToggle = document.getElementById("lang-toggle");
        langToggle?.setAttribute("aria-label", locale.ui.langButton);

        document.querySelectorAll<HTMLButtonElement>("[data-lang-value]").forEach((btn) => {
          const active = btn.getAttribute("data-lang-value") === code;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", active ? "true" : "false");
        });

        renderProjects(locale);
        renderEducation(locale);
        renderSkillTiles(locale);
        syncThemeToggle();
      }

      function setLangMenuOpen(open: boolean) {
        const switchEl = document.getElementById("lang-switch");
        const toggle = document.getElementById("lang-toggle");
        if (!switchEl || !toggle) return;
        switchEl.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
      }

      const themeToggle = document.getElementById("theme-toggle");
      themeToggle?.addEventListener("click", () => {
        const next = getTheme() === "dark" ? "light" : "dark";
        runThemeWipe(themeToggle, next);
      });

      const langSwitch = document.getElementById("lang-switch");
      const langToggle = document.getElementById("lang-toggle");
      const langMenu = document.getElementById("lang-menu");

      langSwitch?.addEventListener("pointerenter", () => {
        setLangMenuOpen(true);
      });
      langSwitch?.addEventListener("pointerleave", () => {
        setLangMenuOpen(false);
      });

      langToggle?.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = langToggle.getAttribute("aria-expanded") !== "true";
        setLangMenuOpen(open);
      });

      langMenu?.querySelectorAll<HTMLButtonElement>("[data-lang-value]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const value = btn.getAttribute("data-lang-value");
          if (value === "en" || value === "zh-Hant") applyLang(value);
          setLangMenuOpen(false);
        });
      });

      document.addEventListener("click", (event) => {
        const switchEl = document.getElementById("lang-switch");
        if (!switchEl) return;
        if (!switchEl.contains(event.target as Node)) setLangMenuOpen(false);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setLangMenuOpen(false);
      });

      applyLang(getLang());
    </script>
  </body>
</html>
