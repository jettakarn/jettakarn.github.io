---
import "../styles/global.css";
import { cvData } from "../data/cvData.js";

const {
  name,
  title,
  tagline,
  education,
  skills,
  projects,
  currentFocus,
  interests,
  socials,
  email,
} = cvData;
const currentYear = new Date().getFullYear();
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${name} — ${title}. ${tagline}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{name} | Portfolio</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored === "light" || stored === "dark" ? stored : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="site-grain" aria-hidden="true"></div>

    <header class="relative min-h-screen flex flex-col">
      <nav
        class="flex items-center justify-between px-6 md:px-10 pt-8 max-w-6xl mx-auto w-full"
      >
        <a
          href="/"
          class="font-display text-sm tracking-[0.2em] uppercase text-[var(--ink)] no-underline"
        >
          JK
        </a>
        <div class="flex items-center gap-4 md:gap-5">
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Switch to light mode"
          >
            <svg
              class="icon-sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg
              class="icon-moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"></path>
            </svg>
          </button>
          <a
            href={socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="GitHub"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path>
            </svg>
          </a>
          <a
            href={socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="LinkedIn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
        </div>
      </nav>

      <div
        class="flex-1 flex flex-col justify-center px-6 md:px-10 max-w-6xl mx-auto w-full pb-24 pt-16"
      >
        <p
          class="animate-fade-up text-xs md:text-sm tracking-[0.25em] uppercase text-[var(--ink-muted)] mb-6"
        >
          {title}
        </p>

        <h1
          class="animate-fade-up-delay-1 font-display text-[clamp(2.75rem,10vw,7rem)] leading-[0.95] font-extrabold tracking-tight text-[var(--ink)] max-w-4xl"
        >
          {name}
        </h1>

        <div
          class="hero-rule mt-8 mb-8 h-px w-24 md:w-40 bg-[var(--line-strong)]"
          aria-hidden="true"
        >
        </div>

        <p
          class="animate-fade-up-delay-2 text-lg md:text-xl text-[var(--ink-muted)] max-w-xl leading-relaxed"
        >
          {tagline}
        </p>

        <div class="animate-fade-up-delay-3 mt-10 flex flex-wrap gap-3">
          <a href={`mailto:${email}`} class="btn-primary">
            Let's connect
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>
          <a href="#projects" class="btn-ghost">View projects</a>
        </div>
      </div>

      <a
        href="#projects"
        class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 text-[var(--ink-faint)] no-underline"
        aria-label="Scroll to projects"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </header>

    <main class="max-w-6xl mx-auto px-6 md:px-10 pb-24 space-y-28">
      <section id="projects" class="scroll-mt-16">
        <div class="flex items-end justify-between gap-4 mb-10 border-b border-[var(--line)] pb-4">
          <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">
            Projects
          </h2>
          <p class="text-sm text-[var(--ink-faint)] hidden sm:block">
            Selected work
          </p>
        </div>

        <ul class="list-none m-0 p-0 divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {
            projects.map((project) => (
              <li>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-row group flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8 py-8 no-underline text-inherit"
                >
                  <span class="text-xs tracking-widest text-[var(--ink-faint)] font-medium md:w-16 shrink-0">
                    {project.year}
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-3 flex-wrap">
                      <h3 class="font-display text-xl md:text-2xl font-semibold m-0 group-hover:underline underline-offset-4 decoration-1">
                        {project.name}
                      </h3>
                      <svg
                        class="opacity-0 group-hover:opacity-100 transition-opacity shrink-0"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path d="M7 17L17 7M7 7h10v10"></path>
                      </svg>
                    </div>
                    <p class="mt-2 mb-0 text-[var(--ink-muted)] leading-relaxed max-w-2xl">
                      {project.description}
                    </p>
                    <p class="mt-3 mb-0 text-sm text-[var(--ink-faint)] tracking-wide">
                      {project.stack.join(" · ")}
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
        <div class="md:col-span-4">
          <h2
            class="font-display text-sm tracking-[0.2em] uppercase text-[var(--ink)] md:sticky md:top-10"
          >
            Education
          </h2>
        </div>
        <div class="md:col-span-8">
          <div
            class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-1 mb-2"
          >
            <h3 class="text-xl font-medium m-0">{education.degree}</h3>
            <span class="text-sm text-[var(--ink-faint)] tracking-wide"
              >{education.period}</span
            >
          </div>
          <p class="text-lg text-[var(--ink-muted)] m-0">{education.school}</p>
          <p class="text-sm text-[var(--ink-faint)] mt-3 mb-0 leading-relaxed">
            {education.description}
          </p>
        </div>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
        <div class="md:col-span-4">
          <h2
            class="font-display text-sm tracking-[0.2em] uppercase text-[var(--ink)] md:sticky md:top-10"
          >
            Skills
          </h2>
        </div>
        <div class="md:col-span-8 space-y-8">
          <div>
            <h3 class="text-base font-medium m-0 mb-2">Languages</h3>
            <p class="m-0 text-[var(--ink-muted)] leading-relaxed">
              {skills.languages.join(" · ")}
            </p>
          </div>
          <div class="h-px bg-[var(--line)] w-full"></div>
          <div>
            <h3 class="text-base font-medium m-0 mb-3">Focus</h3>
            <ul class="m-0 pl-5 text-[var(--ink-muted)] space-y-2 marker:text-[var(--ink)]">
              {currentFocus.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="h-px bg-[var(--line)] w-full"></div>
          <div>
            <h3 class="text-base font-medium m-0 mb-2">Competencies</h3>
            <p class="m-0 text-[var(--ink-muted)] leading-relaxed">
              {skills.competencies.join(" · ")}
            </p>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
        <div class="md:col-span-4">
          <h2
            class="font-display text-sm tracking-[0.2em] uppercase text-[var(--ink)] md:sticky md:top-10"
          >
            Interests
          </h2>
        </div>
        <div class="md:col-span-8">
          <p class="m-0 text-lg text-[var(--ink-muted)] tracking-wide">
            {interests.join(" · ")}
          </p>
        </div>
      </section>
    </main>

    <footer
      class="max-w-6xl mx-auto px-6 md:px-10 py-12 border-t border-[var(--line)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
    >
      <p class="m-0 text-sm text-[var(--ink-faint)]">
        © {currentYear} {name}
      </p>
      <div class="flex gap-5 text-sm">
        <a
          href={socials.leetcode}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link no-underline"
          >LeetCode</a
        >
        <a href={`mailto:${email}`} class="social-link no-underline">{email}</a>
      </div>
    </footer>

    <script>
      const STORAGE_KEY = "theme";

      function getTheme() {
        return document.documentElement.getAttribute("data-theme") === "light"
          ? "light"
          : "dark";
      }

      function setTheme(theme: "light" | "dark") {
        document.documentElement.setAttribute("data-theme", theme);
        try {
          localStorage.setItem(STORAGE_KEY, theme);
        } catch (_) {
          /* ignore */
        }
        syncToggle(theme);
      }

      function syncToggle(theme: "light" | "dark") {
        const button = document.getElementById("theme-toggle");
        if (!button) return;
        button.setAttribute(
          "aria-label",
          theme === "dark" ? "Switch to light mode" : "Switch to dark mode",
        );
      }

      const toggle = document.getElementById("theme-toggle");
      syncToggle(getTheme());
      toggle?.addEventListener("click", () => {
        setTheme(getTheme() === "dark" ? "light" : "dark");
      });
    </script>
  </body>
</html>
